group_by(
n, transform, strength,
signal_representation,
observed_representation,
model
) %>%
summarize(
mean_r2 = mean(r2_test),
.groups = "drop"
) %>%
left_join(
hermite,
by = c("transform", "strength")
)
analysis <- raw %>%
group_by(
n, transform, strength,
signal_representation,
observed_representation,
model
) %>%
summarize(
