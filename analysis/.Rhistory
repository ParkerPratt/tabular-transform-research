library(tidyverse)
library(readxl)
library(broom)
files = list.files(
path = "../results",
pattern = "xgb_monotone",
full.names = TRUE
)
raw = bind_rows(lapply(files, function(f) {
read_excel(f)
}))
baseline <- raw
baseline %>%
group_by(model) %>%
summarise(
mean_r2 = mean(r2_test, na.rm = TRUE),
sd_r2 = sd(r2_test, na.rm = TRUE),
reps = n(),
.groups = "drop"
)
baseline %>%
group_by(model, transform, strength, n, observed_representation, signal_representation) %>%
summarise(
